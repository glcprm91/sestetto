# Copia questo file in .env.local per le prove in locale; su Vercel imposta le stesse
# variabili in Settings → Environment Variables. Tutte sono facoltative.

# Indirizzo pubblico del sito. Su Vercel si ricava da solo: serve solo per forzarlo.
VITE_SITE_URL=

# Titolare e contatto mostrati nell'informativa privacy (per esempio nome e email).
# Senza questi due valori Google Analytics resta spento.
VITE_SITE_OWNER=
VITE_SITE_CONTACT=

# ID di misurazione di Google Analytics 4 (G-XXXXXXXXXX). Se impostato compare il banner per il consenso.
VITE_GA_ID=

# Codice di verifica di Google Search Console (metodo "tag HTML": solo il valore di content).
VITE_GOOGLE_SITE_VERIFICATION=
